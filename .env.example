# Application Environment
APP_ENV=development
APP_NAME=semantic-search-engine
DEBUG=false

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Security & Authentication (Comma-separated keys or role-based)
API_KEY_ADMIN=admin-secret-key-12345
API_KEY_OPERATOR=operator-secret-key-12345
API_KEY_READONLY=readonly-secret-key-12345
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=120
MAX_QUERY_LENGTH=2000
MAX_DOCUMENT_SIZE_MB=25

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=64
EMBEDDING_NORMALIZE=true
EMBEDDING_DEVICE=cpu

# FAISS Configuration
FAISS_INDEX_TYPE=HNSW
FAISS_METRIC=cosine
FAISS_M=32
FAISS_EF_CONSTRUCTION=200
FAISS_EF_SEARCH=64
FAISS_NLIST=1024
FAISS_NPROBE=32

# Storage & Versioning Paths
DATA_DIR=./data
INDEX_DIR=./data/indexes
INDEX_CURRENT_PATH=./data/indexes/current

# Retrieval Configuration
RETRIEVAL_SEMANTIC_WEIGHT=0.7
RETRIEVAL_LEXICAL_WEIGHT=0.3
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_FINAL_K=10
RETRIEVAL_RRF_K=60

# Chunking Strategy Configuration
CHUNKING_STRATEGY=structure
CHUNKING_TARGET_TOKENS=350
CHUNKING_MIN_TOKENS=100
CHUNKING_MAX_TOKENS=600
CHUNKING_OVERLAP_TOKENS=50

# RAG Configuration
RAG_MAX_CONTEXT_TOKENS=2048
RAG_MAX_CHUNKS=5
RAG_MAX_CHUNKS_PER_DOC=2
RAG_LLM_PROVIDER=local

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_METRICS_ENABLED=true
